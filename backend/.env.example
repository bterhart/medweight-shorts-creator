# Copy to .env (same directory as this file) and fill in real values.
# .env is gitignored - never commit real keys.

CHATBOT_SHORTS_DATA_DIR=/home/medweight/chatbot-shorts/data

CHATBOT_SHORTS_DB_HOST=localhost
CHATBOT_SHORTS_DB_PORT=3306
CHATBOT_SHORTS_DB_USER=
CHATBOT_SHORTS_DB_PASSWORD=
CHATBOT_SHORTS_DB_NAME=chatbot_shorts

ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=

# Optional - slide-to-transcript alignment (backend/alignment.py). Effort is
# the latency/quality lever: medium if alignment is slow, xhigh if a deck
# aligns poorly. Fallbacks re-run a classifier-declined request on
# Anthropic's recommended substitute server-side; set to 0 only if the API
# rejects the parameter.
ALIGNMENT_MODEL=claude-opus-5
ALIGNMENT_EFFORT=high
ALIGNMENT_FALLBACKS=1

# Slide rasterisation. Long edge in pixels of the full-resolution slide image
# the render uses (default 3840: past the UI's largest 1920-wide output, with
# 4K headroom) and of the small rendition the review UI loads (default 1280).
# Vector slide content sharpens with the first number; embedded photos can't -
# their ceiling is set when the deck is exported (turn image compression off).
#SLIDE_IMAGE_LONG_EDGE_PX=3840
#SLIDE_PREVIEW_LONG_EDGE_PX=1280

# Rendering runs on AWS Fargate (see fargate_client.py) - the cPanel host's
# CPU throttling made in-process rendering take 50+ minutes for a 33-second
# test video. AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY are read directly by
# boto3 - give this IAM user only ecs:RunTask, ecs:DescribeTasks,
# s3:PutObject/GetObject/DeleteObject on the bucket below (DeleteObject is
# what lets a re-render replace the previous video; without it the render
# still succeeds but old videos accumulate and the short records a
# staleDeleteError), and iam:PassRole on the two ECS roles (task role + task
# execution role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
RENDER_S3_BUCKET=
RENDER_ECS_CLUSTER=chatbot-shorts-cluster
RENDER_ECS_TASK_DEFINITION=chatbot-shorts-render
RENDER_ECS_SUBNETS=
RENDER_ECS_SECURITY_GROUPS=
# How long the worker waits on one Fargate render before failing the short.
# Measured: a 90s short at preview size ~4 min; a 5-minute short with a 60s
# embedded clip ~9 min. Leave headroom for "Full" 1080p renders of long shorts.
RENDER_TIMEOUT_MINUTES=40
